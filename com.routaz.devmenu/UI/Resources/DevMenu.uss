.devmethod-container {
    border-top-width: 1px;
    border-top-color: #444;
    padding: 10px;
    margin-bottom: 10px;
    background-color: #222;
    flex-direction: column;
}

.devmethod-title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 6px;
    color: #ddd;
}

.devmethod-body {
    flex-direction: column;
}

.scroll-container {
    flex-grow: 1;
    padding: 10px;
    background-color: #1e1e1e;
}

.group-container {
    margin-top: 10px;
    margin-bottom: 10px;
    padding-left: 5px;
    flex-direction: column;
}

.group-header {
    -unity-font-style: bold;
    font-size: 13px;
    color: #eee;
    margin-bottom: 4px;
}